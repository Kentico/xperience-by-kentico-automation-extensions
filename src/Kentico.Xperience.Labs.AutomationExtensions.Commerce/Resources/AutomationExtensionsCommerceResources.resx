  <!-- Order completed -->
  <data name="labs.automationextensions.ordercompleted.displayname" xml:space="preserve">
    <value>Order completed</value>
  </data>
  <data name="labs.automationextensions.ordercompleted.description" xml:space="preserve">
    <value>Starts when a visitor completes an order – requires checkout code set up by your developers.</value>
  </data>
  <data name="labs.automationextensions.ordercompleted.minimumtotal.label" xml:space="preserve">
    <value>Minimum order total</value>
  </data>
  <data name="labs.automationextensions.ordercompleted.minimumtotal.explanation" xml:space="preserve">
    <value>Starts only for orders with a grand total (including tax and shipping) of at least this amount. Use 0 for any order.</value>
  </data>
  <data name="labs.automationextensions.ordercompleted.minimumtotal.minimum" xml:space="preserve">
    <value>Enter 0 or a higher amount.</value>
  </data>
  <data name="labs.automationextensions.ordercompleted.currency.label" xml:space="preserve">
    <value>Currency</value>
  </data>
  <data name="labs.automationextensions.ordercompleted.currency.explanation" xml:space="preserve">
    <value>Starts only for orders in this currency, e.g. USD.&lt;br&gt;Leave empty for any currency.&lt;br&gt;Must match the currency code your site sends with each order.</value>
  </data>
  <data name="labs.automationextensions.ordercompleted.currency.maxlength" xml:space="preserve">
    <value>Enter at most 10 characters.</value>
  </data>
  <data name="labs.automationextensions.ordercompleted.firstorderonly.label" xml:space="preserve">
    <value>First order only</value>
  </data>
  <data name="labs.automationextensions.ordercompleted.firstorderonly.explanation" xml:space="preserve">
    <value>Starts only when the customer has no earlier order.&lt;br&gt;Matched by customer record, not contact.</value>
  </data>
